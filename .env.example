# Copie este arquivo para ".env" e preencha com as suas chaves.
# O arquivo .env NUNCA vai para o git (está no .gitignore).

# Chave da API da TypeSafe (Jev)
TYPESAFE_API_KEY=

# Chave de uma API compatível com OpenRouter
LLM_API_KEY=

# Modelo do LLM, no formato do OpenRouter (ex.: provedor/nome-do-modelo).
# - NÃO use o sufixo ":online" (ele liga busca na web; o programa recusa).
# - O modelo precisa ter dados de treino só até antes de 15/09/2026 (ver PREREGISTRO.md).
# - Depois de escolher, registre o nome no adendo do PREREGISTRO.md antes de rodar.
LLM_MODELO=
